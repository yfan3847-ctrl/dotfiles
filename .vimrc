" ~/.vimrc — minimal vim configuration

set nocompatible
syntax on
set number
set relativenumber
set tabstop=4
set shiftwidth=4
set expandtab
set autoindent
set smartindent
set hlsearch
set incsearch
set ignorecase
set smartcase
set wildmenu
set laststatus=2
set ruler
set backspace=indent,eol,start
