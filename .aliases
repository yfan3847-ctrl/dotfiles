# ~/.aliases — command aliases

# Navigation
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."

# Git shortcuts
alias gs="git status"
alias gd="git diff"
alias gl="git log --oneline --graph --decorate"
alias gp="git push"
alias ga="git add"
alias gc="git commit"

# List files
alias ll="ls -alF"
alias la="ls -A"
alias l="ls -CF"

# Safety
alias rm="rm -i"
alias cp="cp -i"
alias mv="mv -i"
alias mkdir="mkdir -p"
alias hist="history | grep"
alias reload="source ~/.bashrc"
alias h="history"
alias c="clear"
alias du="du -h --max-depth=1"
alias wget="wget -c"
