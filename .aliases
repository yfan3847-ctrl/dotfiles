# ~/.aliases — command aliases

# Navigation
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."

# Git shortcuts
alias gs="git status"
alias gd="git diff"
alias gl="git log --oneline --graph --decorate"
alias gp="git push"
alias ga="git add"
alias gc="git commit"

# List files
alias ll="ls -alF"
alias la="ls -A"
alias l="ls -CF"

# Safety
alias rm="rm -i"
alias cp="cp -i"
alias mv="mv -i"
alias path="echo $PATH | tr : \\n"
alias untar="tar xvf"
alias cat="bat 2>/dev/null || cat"
alias grep="grep --color=auto"
alias ports="netstat -tulanp"
